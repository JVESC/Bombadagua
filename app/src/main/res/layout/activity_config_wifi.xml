<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".activities.ConfigWifiActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="50dp"
            android:paddingBottom="24dp">

            <!-- Botão voltar -->
            <LinearLayout
                android:id="@+id/btnVoltar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="4dp"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_seta_voltar"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Voltar"
                    android:textSize="16sp"
                    android:textColor="#000000"/>
            </LinearLayout>

            <!-- Título -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="📶"
                    android:textSize="22sp"
                    android:gravity="center"
                    android:background="@drawable/bg_card_cinza"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Configurar ESP32"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="#000000"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Configuração da rede Wi-Fi"
                        android:textSize="14sp"
                        android:textColor="#666666"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Informação -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_cinza"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Conecte o celular à rede da ESP32 para configurar o Wi-Fi."
                    android:textColor="#555555"
                    android:textSize="14sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Depois, informe o nome e a senha da rede que a ESP32 deverá utilizar."
                    android:textColor="#555555"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp"/>

            </LinearLayout>

            <!-- Nome do Wi-Fi -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nome do Wi-Fi"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etWifi"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Ex.: MinhaInternet"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_botao_borda"
                android:layout_marginBottom="20dp"/>

            <!-- Senha do Wi-Fi -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Senha do Wi-Fi"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etSenha"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Senha"
                android:inputType="textPassword"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_botao_borda"
                android:layout_marginBottom="28dp"/>

            <!-- Botão salvar -->
            <Button
                android:id="@+id/btnSalvarWifi"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Salvar Wi-Fi"
                android:background="@drawable/bg_botao_preto"
                app:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:layout_marginBottom="12dp"/>

            <!-- Botão cancelar -->
            <Button
                android:id="@+id/btnCancelarWifi"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Cancelar"
                android:background="@drawable/bg_botao_borda"
                app:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textColor="#000000"
                android:textAllCaps="false"/>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>