<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".activities.ConfigWifiActivity">

    <!-- =========================================================
         TELA 1: INSTRUÇÕES + BOTÕES
         ========================================================= -->

    <ScrollView
        android:id="@+id/containerInstrucoes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="64dp"
            android:paddingBottom="24dp">

            <!-- Botão voltar -->
            <LinearLayout
                android:id="@+id/btnVoltar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="4dp"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_seta_voltar"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Voltar"
                    android:textSize="16sp"
                    android:textColor="#000000"/>
            </LinearLayout>

            <!-- Título -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="📶"
                    android:textSize="22sp"
                    android:gravity="center"
                    android:background="@drawable/bg_card_cinza"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Configurar ESP32"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="#000000"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Configuração da rede Wi-Fi"
                        android:textSize="14sp"
                        android:textColor="#666666"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Informação -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_cinza"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Se a ESP32 ainda não foi configurada, conecte o celular na rede dela (AGUA_SOB_CONTROLE, senha 12345678)."
                    android:textColor="#555555"
                    android:textSize="14sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Se ela já foi configurada antes, conecte o celular na MESMA rede Wi-Fi de casa que ela já está usando. Depois, toque em &quot;Abrir configuração da ESP32&quot;."
                    android:textColor="#555555"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp"/>

            </LinearLayout>

            <!-- Passo 1: conectar o celular na rede da ESP32 -->
            <Button
                android:id="@+id/btnAbrirWifiCelular"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="1. Conectar o celular na rede da ESP32"
                android:background="@drawable/bg_botao_borda"
                app:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textColor="#000000"
                android:textAllCaps="false"
                android:layout_marginBottom="12dp"/>

            <!-- Passo 2: abrir a página de configuração da ESP32 -->
            <Button
                android:id="@+id/btnSalvarWifi"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="2. Abrir configuração da ESP32"
                android:background="@drawable/bg_botao_preto"
                app:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:layout_marginBottom="12dp"/>

            <!-- Botão cancelar -->
            <Button
                android:id="@+id/btnCancelarWifi"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Cancelar"
                android:background="@drawable/bg_botao_borda"
                app:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textColor="#000000"
                android:textAllCaps="false"/>

        </LinearLayout>

    </ScrollView>

    <!-- =========================================================
         TELA 2: WEBVIEW COM A PÁGINA DA PRÓPRIA ESP32
         Começa escondida (visibility="gone") e só aparece quando
         o usuário toca em "Abrir configuração da ESP32".
         ========================================================= -->

    <LinearLayout
        android:id="@+id/containerWebView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Cabeçalho da telinha do WebView -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card_cinza"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:id="@+id/btnVoltarWebView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="4dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_seta_voltar"/>
            </LinearLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Configuração da ESP32"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginStart="8dp"/>

        </LinearLayout>

        <!-- Barra de progresso enquanto a página carrega -->
        <ProgressBar
            android:id="@+id/progressWebView"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"/>

        <WebView
            android:id="@+id/webViewEsp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

    </LinearLayout>

    <!-- =========================================================
         TELA 3: ERRO (não conseguiu acessar a ESP32)
         Aparece quando o WebView falha ao carregar a página —
         geralmente porque o celular não está conectado na rede
         Wi-Fi da ESP32.
         ========================================================= -->

    <LinearLayout
        android:id="@+id/containerErro"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:text="📡"
            android:textSize="34sp"
            android:gravity="center"
            android:background="@drawable/bg_card_cinza"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Não consegui acessar a ESP32"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Conecte o celular na rede Wi-Fi AGUA_SOB_CONTROLE (se ela ainda não foi configurada) ou na mesma rede Wi-Fi de casa que ela já está usando (se já foi configurada antes)."
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginBottom="28dp"/>

        <Button
            android:id="@+id/btnAbrirWifiErro"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Abrir Wi-Fi do celular"
            android:background="@drawable/bg_botao_preto"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnTentarNovamente"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Tentar novamente"
            android:background="@drawable/bg_botao_borda"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textColor="#000000"
            android:textAllCaps="false"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/btnVoltarErro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voltar"
            android:textColor="#555555"
            android:textSize="15sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>