<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Conteúdo principal da tela -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        tools:context=".activities.MainActivity">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Bloco azul superior -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#B8D9F5"
                android:padding="20dp">

                <!-- Linha do topo: logo + nome do app + botão de menu -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_gota"
                            android:background="@drawable/bg_icon_white"
                            android:padding="8dp"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:id="@+id/tvNomeApp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fluvi"
                                android:textSize="18sp"
                                android:textColor="#000000"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Monitoramento de vazão"
                                android:textSize="13sp"
                                android:textColor="#555555"/>

                            <TextView
                                android:id="@+id/tvStatusEsp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🟢 Online"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#2E7D32"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Botão de menu (3 barrinhas) -->
                    <ImageView
                        android:id="@+id/btnMenu"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_menu"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Abrir menu"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Consumo hoje"
                    android:layout_marginTop="16dp"
                    android:textColor="#555555"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom">

                    <TextView
                        android:id="@+id/tvConsumoHoje"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="86"
                        android:textSize="40sp"
                        android:textColor="#000000"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" litros"
                        android:textSize="16sp"
                        android:textColor="#000000"
                        android:layout_marginBottom="8dp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvComparativo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="18% menos que ontem"
                    android:textColor="#2E7D32"
                    android:textSize="13sp"/>
            </LinearLayout>

            <!-- Bloco branco: vazão atual -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vazão atual"
                    android:textColor="#555555"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tvVazaoAtual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.2 L/min"
                    android:textSize="20sp"
                    android:textColor="#000000"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Lista de pontos monitorados: preenche o resto da tela -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pontos monitorados"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:textSize="15sp"
                    android:layout_marginBottom="12dp"/>

                <!-- Item: Chuveiro -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="🚿  Chuveiro"
                        android:textColor="#000000"
                        android:textSize="16sp"/>

                    <TextView
                        android:id="@+id/tvVazaoChuveiro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2.1 L/min"
                        android:textColor="#000000"
                        android:textSize="16sp"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE"/>

                <!-- Item: Cozinha -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="🍷  Cozinha"
                        android:textColor="#000000"
                        android:textSize="16sp"/>

                    <TextView
                        android:id="@+id/tvVazaoCozinha"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.8 L/min"
                        android:textColor="#000000"
                        android:textSize="16sp"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE"/>

                <!-- Item de alerta: Torneira jardim -->
                <LinearLayout
                    android:id="@+id/layoutAlertaVazamento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="⚠️  Torneira jardim"
                        android:textColor="#C62828"
                        android:textSize="16sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="vazamento"
                        android:textColor="#C62828"
                        android:textSize="16sp"/>
                </LinearLayout>

                <!-- Espaço flexível empurra o botão pro rodapé -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <!-- Botão: Ver alerta de vazamento -->
                <Button
                    android:id="@+id/btnVerAlerta"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Ver alerta de vazamento  →"
                    android:background="@drawable/bg_botao_preto"
                    app:backgroundTint="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textColor="#FFFFFF"
                    android:textAllCaps="false"
                    android:layout_marginBottom="16dp"/>

                <!-- Botão: Ver histórico -->
                <Button
                    android:id="@+id/btnVerHistorico"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Ver histórico  →"
                    android:background="@drawable/bg_botao_borda"
                    app:backgroundTint="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textColor="#000000"
                    android:textAllCaps="false"/>

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Painel lateral (drawer) que desliza da direita -->
    <LinearLayout
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:paddingTop="48dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menu"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnConfigWifi"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Configurar Wi-Fi da ESP32"
            android:background="@drawable/bg_botao_borda"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textColor="#000000"
            android:textAllCaps="false"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnSairConta"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Sair da conta"
            android:background="@drawable/bg_botao_borda"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textColor="#C62828"
            android:textAllCaps="false"/>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>